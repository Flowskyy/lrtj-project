# Better Auth URL (required for authentication)
# For LAN access, update this to your LAN IP (e.g., http://172.16.12.230:3000)
# or ensure the IP is added to trustedOrigins in lib/auth.ts
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

