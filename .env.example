# Database
# IMPORTANT: Add timezone=Asia/Jakarta to ensure timestamps are stored in WIB (UTC+7)
# IMPORTANT: Add connection_limit to prevent connection exhaustion during high concurrency
DATABASE_URL="mysql://user:password@localhost:3306/database?timezone=Asia/Jakarta&connection_limit=20"

# App URL (used for generating signup links in emails)
